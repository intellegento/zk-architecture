{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "year": {
      "type": "integer"
    },
    "category": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "images": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.project-media"
    },
    "squareBigMedia": {
      "type": "component",
      "repeatable": false,
      "component": "blocks.project-media"
    },
    "squareSmallMedia": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.project-media"
    },
    "storyTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "storyText": {
      "type": "customField",
      "options": {
        "preset": "defaultHtml"
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "locationTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "locationImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "mapImage": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "conceptTitle": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "conceptText": {
      "type": "customField",
      "options": {
        "preset": "defaultHtml"
      },
      "customField": "plugin::ckeditor5.CKEditor",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "conceptImages": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.project-media"
    },
    "imagesSlider": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.project-media"
    },
    "detailedInfoProject": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.project-detailed",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "projectDescriptions": {
      "type": "component",
      "repeatable": true,
      "component": "blocks.project-description",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "prevLink": {
      "type": "string"
    },
    "nextLink": {
      "type": "string"
    }
  }
}
